{
  "functions": {
    "api/release.js": {
      "maxDuration": 10
    },
    "api/admin.js": {
      "maxDuration": 10
    },
    "api/telemetry.js": {
      "maxDuration": 10
    },
    "api/config.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
